{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flock Safety API Platform (v3) Alerts OAuth2 API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "OAuth2",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.flocksafety.com/api/v3/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "audience",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.flocksafety.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve an Access Token"
        }
      ]
    }
  ],
  "bundled": true
}