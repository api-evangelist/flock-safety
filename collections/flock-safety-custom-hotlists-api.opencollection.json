            "name": "Retrieve a page of entries for a hotlist",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flocksafety.com/api/v3/hotlists/:hotlistId/entries",
            "params": [
              {
                "name": "limit",
                "value": "",
