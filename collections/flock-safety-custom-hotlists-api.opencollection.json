        {
          "info": {
            "name": "Retrieve custom hotlists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flocksafety.com/api/v3/hotlists",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.flocksafety.com/oauth/token",
