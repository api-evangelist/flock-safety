            "name": "Add a batch of entries to a hotlist",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.flocksafety.com/api/v3/hotlists/:hotlistId/entries/addBatch",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.flocksafety.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Add a batch of entries to the hotlist with the provided hotlistID. All entries will be normalized (O->0) and have whitespace trimmed. Duplicate entries will be ignored."
