          "id": "afe77f70-3c8f-4c4d-9704-ba1a59f0a7b9",
          "name": "Uploading images of a vehicle.",
          "request": {
            "name": "Uploading images of a vehicle.",
            "description": {
              "content": "Uploads images of a vehicle that will be ingested and processed. The total size of the main vehicle image and all of the context images must not exceed 9 MB. File size is calculated in binary mb (MB), where 1 MB is 1048576 bytes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices",
                ":deviceId",
                "images"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceId",
                  "description": "(Required) The ID of the device that this image was captured by."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "contentType": "image/jpeg",
                  "description": "(Required) The image to ingest and process into FlockOS."
                },
                {
                  "key": "contextImages",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "contentType": "image/jpeg",
                  "description": "Additional context images to be ingested. These images will not be processed but will be viewable alongside the main image\n"
                },
                {
                  "key": "capturedAt",
                  "value": "<dateTime>",
                  "type": "text",
                  "description": "The timestamp (in RFC3339 UTC format) indicating when the image was captured."
                },
                {
                  "key": "latitude",
                  "value": "<float>",
                  "type": "text",
                  "description": "The latitude of the location where the images were captured."
                },
                {
                  "key": "longitude",
                  "value": "<float>",
                  "type": "text",
                  "description": "The longitude of the location where the images were captured."
                }
              ]
            }
          },
